# Sao chép thành file .env khi chạy thử trên máy (npm run dev). KHÔNG đưa file .env lên GitHub.
# Trên Vercel: Project → Settings → Environment Variables, nhập các biến dưới đây.

# Chuỗi kết nối MongoDB Atlas (thay <db_password> bằng mật khẩu database user)
MONGODB_URI=mongodb+srv://duydemo1294:<db_password>@duydt19.ayap1vy.mongodb.net/?retryWrites=true&w=majority&appName=Duydt19

# (Không bắt buộc) Client ID "Sign in with Google" – đã cài sẵn trong code, chỉ đặt khi muốn đổi
# GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com

# (Không bắt buộc) Danh sách Gmail chủ quán, phân cách dấu phẩy. Mặc định:
# OWNER_EMAILS=duydemo1294@gmail.com,hangochien2023@gmail.com

# Mật khẩu chủ quán dự phòng (khi không đăng nhập Gmail được)
OWNER_PASSWORD=doi-mat-khau-nay

# Chuỗi bí mật để ký phiên đăng nhập (một dãy ngẫu nhiên dài bất kỳ, vd 40 ký tự)
SESSION_SECRET=thay-bang-chuoi-ngau-nhien-dai

# (Không bắt buộc) Tên database, mặc định gubilliard
# MONGODB_DB=gubilliard
